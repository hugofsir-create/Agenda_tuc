rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidContact(data) {
      return data.keys().hasAll(['client', 'city', 'address']) &&
             data.client is string && data.client.size() <= 200 &&
             data.city is string && data.city.size() <= 100 &&
             data.address is string && data.address.size() <= 300;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['username', 'name', 'password', 'role', 'status']) &&
             data.username is string && data.username.size() <= 120 &&
             data.name is string && data.name.size() <= 150 &&
             data.password is string && data.password.size() <= 120 &&
             data.role in ['admin', 'operator', 'driver'] &&
             data.status in ['active', 'inactive'];
    }

    function isValidContactRequest(data) {
      return data.keys().hasAll(['client', 'city', 'address', 'status', 'submittedByUserId']) &&
             data.client is string && data.client.size() <= 200 &&
             data.city is string && data.city.size() <= 100 &&
             data.address is string && data.address.size() <= 300 &&
             data.status in ['pending', 'approved', 'rejected'];
    }

    match /test/connection {
      allow get: if true;
    }

    match /contacts/{contactId} {
      allow get, list: if true;
      
      allow create: if isValidId(contactId) && 
                      isValidContact(request.resource.data);
                      
      allow update: if isValidContact(request.resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'id', 'client', 'subClient', 'contactName', 'phone', 
                        'altContactName', 'altPhone', 'city', 'address', 
                        'unloadingHours', 'notes', 'lastContacted', 'ownerId', 'updatedAt', 'createdAt'
                      ]);
                      
      allow delete: if true;
    }

    match /users/{userId} {
      allow get, list: if true;
      allow create: if isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isValidUser(request.resource.data);
      allow delete: if true;
    }

    match /contact_requests/{requestId} {
      allow get, list: if true;
      allow create: if isValidId(requestId) && isValidContactRequest(request.resource.data);
      allow update: if isValidContactRequest(request.resource.data);
      allow delete: if true;
    }
  }
}
